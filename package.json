{
  "name": "crackit-ai",
  "version": "1.0.0",
  "description": "AI Career Success Platform - End-to-End Job Preparation SaaS",
  "main": "index.js",
  "scripts": {
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install",
    "install-all": "npm run install-server && npm run install-client",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "build:server": "cd server && npm install --production",
    "build:all": "npm run build:server && npm run build",
    "start": "cd server && npm start",
    "lint": "cd client && npm run lint",
    "lint:fix": "cd client && npm run lint -- --fix",
    "clean": "rm -rf node_modules server/node_modules client/node_modules client/dist",
    "deploy:check": "npm run lint && npm run build"
  },
  "keywords": [
    "ai",
    "career",
    "job-preparation",
    "saas",
    "mern",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "CrackIt AI Team",
  "license": "PROPRIETARY",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
