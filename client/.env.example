# ══════════════════════════════════════════════════════════════════════════════
# CrackIt AI — Frontend Environment Variables (Vite)
# All VITE_* variables are bundled into the client — never put secrets here.
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# Backend API base URL
# Dev:  http://localhost:5000/api
# Prod: https://crackitai-dwhs.onrender.com/api
VITE_API_URL=https://crackitai-dwhs.onrender.com/api

# App metadata
VITE_APP_NAME=CrackIt AI
VITE_APP_URL=http://localhost:5173
# VITE_APP_URL=https://crackiitai.vercel.app   # production

# ── Razorpay PUBLIC key only ───────────────────────────────────────────────────
# This is the KEY_ID (starts with rzp_test_ or rzp_live_) — it is safe to
# expose in the frontend. The KEY_SECRET must NEVER appear here.
#
# NOTE: In this app the backend returns RAZORPAY_KEY_ID via the /billing/create-order
# response, so this frontend variable is a fallback only.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ══════════════════════════════════════════════════════════════════════════════
# NEVER PUT THESE HERE:
#   RAZORPAY_KEY_SECRET
#   RAZORPAY_WEBHOOK_SECRET
#   JWT_SECRET
#   MONGODB_URI
#   OPENAI_API_KEY
# ══════════════════════════════════════════════════════════════════════════════
