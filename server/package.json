{
  "name": "crackit-ai-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --runInBand",
    "seed:companies": "node scripts/seedCompanies.js",
    "seed:tests": "node scripts/seedTests.js",
    "seed:all": "node scripts/initializeDatabase.js",
    "check:companies": "node scripts/checkCompanies.js",
    "check:tests": "node scripts/checkTests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.9",
    "openai": "^4.28.0",
    "pdf-parse": "^1.1.4",
    "razorpay": "^2.9.8",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.3"
  },
  "jest": {
    "extensionsToTreatAsEsm": [".js"],
    "transform": {},
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 30000
  }
}
