# ══════════════════════════════════════════════════════════════════════════════
# CrackIt AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/crackit-ai?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# ── OpenAI ────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# For Gmail: enable 2FA → create App Password (not your Gmail password)
# App Passwords: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password-16-chars
EMAIL_FROM="CrackIt AI <noreply@crackit.ai>"

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com/app/keys
#
# TEST MODE  — use rzp_test_* keys (no real money, test cards available)
# LIVE MODE  — use rzp_live_* keys (real money — only in production)
#
# KEY_ID is semi-public (sent to frontend for checkout). KEY_SECRET is NEVER sent to frontend.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook secret: set in Razorpay Dashboard → Webhooks → your endpoint → Secret
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is DIFFERENT from KEY_SECRET — it is used only to verify webhook payloads.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173          # Dev: Vite default port
# CLIENT_URL=https://crackiitai.vercel.app  # Production

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880       # 5 MB in bytes
ALLOWED_FILE_TYPES=pdf,doc,docx

# ── Admin ─────────────────────────────────────────────────────────────────────
# Set this in production to restrict admin route access at the network level.
# Admin routes also require JWT + role=admin on the User document.
# ADMIN_EMAIL=admin@yourcompany.com

# ══════════════════════════════════════════════════════════════════════════════
# VARIABLE GUIDE
#
# LOCAL DEVELOPMENT (TEST MODE)
#   RAZORPAY_KEY_ID     = rzp_test_*   (from Razorpay test dashboard)
#   RAZORPAY_KEY_SECRET = test secret  (from Razorpay test dashboard)
#   RAZORPAY_WEBHOOK_SECRET = any string (Razorpay won't verify in local dev)
#   NODE_ENV            = development
#
# PRODUCTION (LIVE MODE)
#   RAZORPAY_KEY_ID     = rzp_live_*   (from Razorpay live dashboard)
#   RAZORPAY_KEY_SECRET = live secret  (from Razorpay live dashboard)
#   RAZORPAY_WEBHOOK_SECRET = secret set in Razorpay Dashboard webhook config
#   NODE_ENV            = production
#   CLIENT_URL          = https://crackiitai.vercel.app
#
# WARNING: Never mix rzp_test_* and rzp_live_* credentials in the same env.
# ══════════════════════════════════════════════════════════════════════════════
